# Copie este arquivo para .env.local e preencha com os valores do firebaseConfig
# (console do Firebase > Configurações do projeto > Seus apps > app Web).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# Opcional: sem elas, o site usa o projeto escritorio-arquitetura-cc55d (valores em src/lib/firebase.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
